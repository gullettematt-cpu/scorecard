<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Notice</name>
        <label>Email the draw notice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Get_Recipient.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>NoticeSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>NoticeBody</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <constants>
        <name>NoticeRecipientName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Mike Duncan</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Recipient_Found</name>
        <label>Recipient found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Recipient</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Notice</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Vista: emails Mike Duncan about every draw (payment before job completion) issued from Vista. A draw is an SA Expense with Type = Vista and Did_you_complete_the_job_or_service__c = No. The recipient is looked up by name (constant NoticeRecipientName) among active users. See vista/docs/approval-flow.md.</description>
    <environments>Default</environments>
    <formulas>
        <name>AmountText</name>
        <dataType>String</dataType>
        <expression>&quot;$&quot; &amp; TEXT({!$Record.Amount__c})</expression>
    </formulas>
    <formulas>
        <name>RecordLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_260})) &amp; {!$Record.Id}</expression>
    </formulas>
    <interviewLabel>Vista Draw Issued Notice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Vista - Draw Issued Notice</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Recipient</name>
        <label>Find Mike Duncan</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Recipient_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>NoticeRecipientName</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Email</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Recipient</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Vista</stringValue>
            </value>
        </filters>
        <filters>
            <field>Did_you_complete_the_job_or_service__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No</stringValue>
            </value>
        </filters>
        <filters>
            <field>TEST_SA__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>SA_Expense__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>NoticeBody</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>A draw was issued in Vista (payment before the job is complete).

Amount: {!AmountText}
Job: {!$Record.Job_Name__c}
Customer: {!$Record.Account_Name__c}
Installer: {!$Record.Installer_Name__c}
Issued by (PM): {!$Record.Approver__c}
Covers: {!$Record.Description_of_Work_Performed__c}

Status: {!$Record.Status__c}. It moves through Salesforce as approved.
Record: {!RecordLink}</text>
    </textTemplates>
    <textTemplates>
        <name>NoticeSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Vista draw issued: {!AmountText} · {!$Record.Job_Name__c}</text>
    </textTemplates>
</Flow>
