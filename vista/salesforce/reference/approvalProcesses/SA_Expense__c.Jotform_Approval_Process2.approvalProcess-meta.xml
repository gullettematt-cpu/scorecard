<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <submitter>All</submitter>
        <type>group</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Date__c</field>
        <field>Account__c</field>
        <field>Amount__c</field>
        <field>Work_Type__c</field>
        <field>Cost_Percent__c</field>
        <field>Expense_Type__c</field>
        <field>Commissionable_Amount__c</field>
        <field>Description_of_Work_Performed__c</field>
        <field>Cost_Flat_Fee__c</field>
        <field>Owner</field>
        <field>Cost_Miscellaneous__c</field>
        <field>CreatedBy</field>
        <field>Total_Cost__c</field>
        <field>Work_Performed_Date__c</field>
        <field>SA_Expense_over_Sales_Price__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>PreviousApprover</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>OA</label>
        <name>OA</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>Production_Manager__c</name>
                <type>relatedUserField</type>
            </approver>
            <approver>
                <name>mgullette@southernindustries.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>PM</label>
        <name>PM</name>
        <rejectBehavior>
            <type>BackToPrevious</type>
        </rejectBehavior>
    </approvalStep>
    <description>Coming from Jotform</description>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>SA_Expense__c.Type__c</field>
            <operation>equals</operation>
            <value>Jotform</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Status_rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Jotform_Approver</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Jotform Approval Process</label>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>New</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
